#!/usr/bin/env node
// Geofence fairness eval: the runner.
//   node evals/geofence/run.mts             writes docs/evals/geofence.md and geofence.json
//   node evals/geofence/run.mts --check     exits 1 if either committed file is out of date
//   node evals/geofence/run.mts --trials N  trials per cell (the committed report uses the default)
// Everything is simulated from a seeded random generator. No real location data.
import fs from 'node:fs';
import path from 'node:path';
import { createRequire } from 'node:module';
import { fileURLToPath } from 'node:url';
import {
  DEFAULT_SEED, DEFAULT_TRIALS, RADII_FT, ENVIRONMENTS, ENV_NAMES, POLICY_NAMES, POLICY_LABELS,
  OFFSITE, MILE_M, CONFIDENCE, R95_OVER_SIGMA, runAll,
} from './model.mts';
import type { Cell, MetricKey, Offsite, Result } from './model.mts';

const require = createRequire(import.meta.url);
const Geo = require('../../js/geo.js') as typeof import('../../js/geo.js');

const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', '..');
const OUT_DIR = path.join(ROOT, 'docs', 'evals');
const MD_PATH = path.join(OUT_DIR, 'geofence.md');
const JSON_PATH = path.join(OUT_DIR, 'geofence.json');

const pct = (x: number) => (x * 100).toFixed(1) + '%';
const points = (x: number) => (x * 100).toFixed(1);
const whole = (x: number) => String(Math.round(x));
const offLabel = (o: Offsite) => o.label;

export function buildJson(result: Result) {
  return {
    note: 'Simulated from a seeded random generator. Not field data. Generated by npm run eval:geofence; do not edit by hand.',
    seed: result.seed,
    trials: result.trials,
    radiiFt: RADII_FT,
    environments: ENVIRONMENTS,
    policies: POLICY_NAMES,
    cells: result.cells,
  };
}

export function renderJson(result: Result): string {
  return JSON.stringify(buildJson(result), null, 2) + '\n';
}

export function renderReport(result: Result): string {
  const cell = (env: string, radiusFt: number, policy: string): Cell => {
    const c = result.cells.find((x) => x.env === env && x.radiusFt === radiusFt && x.policy === policy);
    if (!c) throw new Error(`no cell for ${env} ${radiusFt} ${policy}`);
    return c;
  };
  const HEAD_FT = RADII_FT[1];
  const near = OFFSITE[0];
  const nearKey: MetricKey = `offsitePassed${near.key}`;

  // Every (cell, off-site distance) pair for the shipped rule, worst false pass first.
  type Pass = { env: string, radiusFt: number, off: Offsite, value: number };
  const fairPasses: Pass[] = [];
  for (const c of result.cells) {
    if (c.policy !== 'fair') continue;
    for (const o of OFFSITE) fairPasses.push({ env: c.env, radiusFt: c.radiusFt, off: o, value: c[`offsitePassed${o.key}`] });
  }
  fairPasses.sort((a, b) => b.value - a.value);
  const worst = fairPasses[0];
  const at = (p: Pass, policy: string) => cell(p.env, p.radiusFt, policy)[`offsitePassed${p.off.key}`];
  const worstStrict = at(worst, 'strict');
  const worstCapped = at(worst, 'capped');
  const worstCappedCell = cell(worst.env, worst.radiusFt, 'capped');
  const worstFairCell = cell(worst.env, worst.radiusFt, 'fair');

  const lines: string[] = [];
  const p = (s: string) => { lines.push(s, ''); };

  lines.push('<!-- Generated by `npm run eval:geofence` (evals/geofence/run.mts). Do not edit by hand. -->');
  p('# Geofence fairness eval');

  // 1. Summary
  const treeS = cell('tree_cover', HEAD_FT, 'strict');
  const treeF = cell('tree_cover', HEAD_FT, 'fair');
  const holS = cell('hollow', HEAD_FT, 'strict');
  const holF = cell('hollow', HEAD_FT, 'fair');
  const holC = cell('hollow', HEAD_FT, 'capped');
  p([
    `This is a simulated measurement of the clock-in geofence rule, not field data.`,
    `At ${HEAD_FT} ft under tree cover, a strict fence (\`strict\`) wrongly flags ${pct(treeS.onsiteWronglyFlagged)} of workers who are on site; the shipped rule (\`fair\`) wrongly flags ${pct(treeF.onsiteWronglyFlagged)}.`,
    `In a hollow at ${HEAD_FT} ft it is ${pct(holS.onsiteWronglyFlagged)} for \`strict\` and ${pct(holF.onsiteWronglyFlagged)} for \`fair\`.`,
    `The price: in a hollow at ${HEAD_FT} ft, \`fair\` passes ${pct(holF[nearKey])} of people standing ${offLabel(near)} away as on site (\`strict\` ${pct(holS[nearKey])}, the candidate \`capped\` ${pct(holC[nearKey])}).`,
    `The worst case for \`fair\` is ${worst.env} at ${worst.radiusFt} ft: ${pct(worst.value)} of people standing ${offLabel(worst.off)} away pass as on site.`,
  ].join('\n'));

  // 2. What this is and is not
  p('## What this is and is not');
  p([
    `Everything here is simulated from a seeded random generator (seed ${result.seed}, ${result.trials} trials per row). It is not field data, and no real location was used.`,
    `The error model below is a set of assumptions about how phones behave. The real fixes from the beta replace these assumptions (M2.6).`,
  ].join('\n'));
  p([
    `How the simulation works:`,
    `- The phone reports a stated accuracy in meters. By the W3C Geolocation spec that is a ${whole(CONFIDENCE * 100)}% confidence radius.`,
    `- The position error is a 2-D Gaussian, so the error distance follows a Rayleigh curve. Sigma is set so that ${whole(CONFIDENCE * 100)}% of error distances fall within stated accuracy x honesty (sigma = that distance / ${R95_OVER_SIGMA.toFixed(4)}).`,
    `- Honesty is the true ${whole(CONFIDENCE * 100)}% error divided by the stated accuracy. ${whole(ENVIRONMENTS.open_sky.honesty)} is an honest phone; ${whole(ENVIRONMENTS.overconfident.honesty)} means the real error is ${whole(ENVIRONMENTS.overconfident.honesty)} times what the phone claims.`,
    `- A worker who is on site stands at a random spot inside the fence circle (even by area). A person who is off site stands ${OFFSITE.map((o) => o === OFFSITE[OFFSITE.length - 1] ? `${offLabel(o)} (${MILE_M} m)` : offLabel(o)).join(', ')} from the pin, at a random bearing.`,
    `- Distances are flat-earth meters, which is fine at these scales.`,
    `- Every policy is run on the same simulated fixes, so the rows compare like with like.`,
  ].join('\n'));
  p([
    '| Environment | What it stands for | Stated accuracy (m) | Honesty |',
    '|---|---|---|---|',
    ...ENV_NAMES.map((n) => {
      const e = ENVIRONMENTS[n];
      return `| \`${n}\` | ${e.label} | ${e.accuracyMinM} to ${e.accuracyMaxM} | ${e.honesty} |`;
    }),
  ].join('\n'));
  p([
    '| Policy | What it does |',
    '|---|---|',
    ...POLICY_NAMES.map((n) => `| \`${n}\` | ${POLICY_LABELS[n]} |`),
  ].join('\n'));
  p([
    `What the results mean for a clock-in. Nothing is ever blocked.`,
    `- Clean: the rule says on site.`,
    `- Wrongly flagged: the worker is on site but the boss sees a "near" or "off site" flag. This is the unfair outcome.`,
    `- Photo asked: the fix is too weak to judge (stated accuracy worse than ${Geo.WEAK_ACCURACY_M} m), so the worker is asked for a photo instead.`,
    `- Passed as on site: the person is not there but the punch looks clean. This is the missed outcome.`,
  ].join('\n'));
  p([
    'To re-run:',
    '',
    '    npm run eval:geofence                       # rewrite this report and geofence.json',
    '    node evals/geofence/run.mts --check         # fail if the committed files are out of date',
    '    node evals/geofence/run.mts --trials 2000   # a quicker look (do not commit)',
  ].join('\n'));

  // 3. Tables
  p('## Results');
  for (const radiusFt of RADII_FT) {
    p(`### ${radiusFt} ft fence (${whole(Geo.toMeters(radiusFt))} m)`);
    const rows = [
      `| Environment | Policy | On site: clean | On site: wrongly flagged | On site: photo asked | ${OFFSITE.map((o) => `Off site at ${offLabel(o)}: passed as on site`).join(' | ')} |`,
      `|---|---|---|---|---|${OFFSITE.map(() => '---').join('|')}|`,
    ];
    for (const env of ENV_NAMES) for (const policy of POLICY_NAMES) {
      const c = cell(env, radiusFt, policy);
      rows.push(`| \`${env}\` | \`${policy}\` | ${pct(c.onsiteClean)} | ${pct(c.onsiteWronglyFlagged)} | ${pct(c.onsitePhotoAsked)} | ${OFFSITE.map((o) => pct(c[`offsitePassed${o.key}`])).join(' | ')} |`);
    }
    p(rows.join('\n'));
  }

  // 4. Findings
  p('## What it says about the rule');
  const gpsEnvs = ENV_NAMES.filter((n) => ENVIRONMENTS[n].accuracyMaxM <= Geo.WEAK_ACCURACY_M);
  const weakEnvs = ENV_NAMES.filter((n) => ENVIRONMENTS[n].accuracyMinM > Geo.WEAK_ACCURACY_M);
  const honestGps = gpsEnvs.filter((n) => ENVIRONMENTS[n].honesty === 1);
  const dishonest = gpsEnvs.filter((n) => ENVIRONMENTS[n].honesty !== 1);
  const maxOf = (envs: string[], policy: string, key: MetricKey): Cell => {
    let best: Cell | null = null;
    for (const env of envs) for (const radiusFt of RADII_FT) {
      const c = cell(env, radiusFt, policy);
      if (!best || c[key] > best[key]) best = c;
    }
    if (!best) throw new Error('maxOf: no cells');
    return best;
  };
  const tick = (names: string[]) => names.map((n) => '`' + n + '`').join(', ');

  const fairFlagHonest = maxOf(honestGps, 'fair', 'onsiteWronglyFlagged');
  const strictFlagHonest = maxOf(honestGps, 'strict', 'onsiteWronglyFlagged');
  const findings: string[] = [];
  findings.push(`**On-site workers are treated fairly when the phone is honest.** Across ${tick(honestGps)} and all ${RADII_FT.length} radii, \`fair\` wrongly flags at most ${pct(fairFlagHonest.onsiteWronglyFlagged)} of on-site workers (${fairFlagHonest.env}, ${fairFlagHonest.radiusFt} ft). \`strict\` wrongly flags up to ${pct(strictFlagHonest.onsiteWronglyFlagged)} (${strictFlagHonest.env}, ${strictFlagHonest.radiusFt} ft).`);

  for (const env of dishonest) {
    const f = cell(env, HEAD_FT, 'fair');
    const s = cell(env, HEAD_FT, 'strict');
    const fMax = maxOf([env], 'fair', 'onsiteWronglyFlagged');
    findings.push(`**The rule is only as fair as the phone is honest.** In \`${env}\`, where the real error is ${whole(ENVIRONMENTS[env].honesty)} times the stated accuracy, \`fair\` wrongly flags ${pct(f.onsiteWronglyFlagged)} of on-site workers at ${HEAD_FT} ft (\`strict\` ${pct(s.onsiteWronglyFlagged)}), and up to ${pct(fMax.onsiteWronglyFlagged)} at ${fMax.radiusFt} ft.`);
  }

  findings.push(`**The worst false pass for \`fair\`** is ${worst.env} at ${worst.radiusFt} ft: ${pct(worst.value)} of people standing ${offLabel(worst.off)} away pass as on site. On the same cell \`strict\` passes ${pct(worstStrict)} and \`capped\` passes ${pct(worstCapped)}.`);

  const weakCount = fairPasses.filter((x) => x.value > 0.5).length;
  const top = fairPasses.slice(0, 6);
  findings.push(`**Where the shipped rule is weak.** A big stated accuracy on a small fence lets a person who is close but not there pass as on site. The stated accuracy can be as large as ${Geo.WEAK_ACCURACY_M} m before a photo is asked for, and the smallest fence is ${whole(Geo.toMeters(RADII_FT[0]))} m, so the benefit of the doubt can be up to ${(Geo.WEAK_ACCURACY_M / Geo.toMeters(RADII_FT[0])).toFixed(1)} times the fence itself. In ${weakCount} of the ${fairPasses.length} off-site rows, \`fair\` passes more than half of the people who are not there. The ${top.length} worst rows for \`fair\`, with the other two policies on the same simulated fixes:`);

  const lists = findings.map((f) => `- ${f}`);
  p(lists.join('\n'));
  p([
    '| Environment | Fence | True distance | `strict` passes | `fair` passes | `capped` passes |',
    '|---|---|---|---|---|---|',
    ...top.map((x) => `| \`${x.env}\` | ${x.radiusFt} ft | ${offLabel(x.off)} | ${pct(at(x, 'strict'))} | ${pct(x.value)} | ${pct(at(x, 'capped'))} |`),
  ].join('\n'));

  // capped versus fair
  const differs: { env: string, radiusFt: number, f: Cell, c: Cell }[] = [];
  for (const env of ENV_NAMES) for (const radiusFt of RADII_FT) {
    const f = cell(env, radiusFt, 'fair');
    const c = cell(env, radiusFt, 'capped');
    if (JSON.stringify({ ...f, policy: '' }) !== JSON.stringify({ ...c, policy: '' })) differs.push({ env, radiusFt, f, c });
  }
  const more: string[] = [];
  const cellCount = ENV_NAMES.length * RADII_FT.length;
  if (differs.length === 0) {
    more.push(`- **\`capped\` compared with \`fair\`.** The two give the same numbers in all ${cellCount} environment and fence pairs.`);
  } else {
    more.push(`- **\`capped\` compared with \`fair\`.** The two differ in ${differs.length} of the ${cellCount} environment and fence pairs (${differs.map((d) => `${d.env} at ${d.radiusFt} ft`).join(', ')}) and give the same numbers everywhere else, because the cap only matters when the stated accuracy is larger than the radius.`);
    for (const d of differs) {
      more.push(`  - ${d.env} at ${d.radiusFt} ft: false passes at ${offLabel(near)} go from ${pct(d.f[nearKey])} to ${pct(d.c[nearKey])} (${points(d.f[nearKey] - d.c[nearKey])} points lower), and on-site workers wrongly flagged go from ${pct(d.f.onsiteWronglyFlagged)} to ${pct(d.c.onsiteWronglyFlagged)} (${points(d.c.onsiteWronglyFlagged - d.f.onsiteWronglyFlagged)} points higher).`);
    }
    more.push(`  - On the worst cell for \`fair\` (${worst.env}, ${worst.radiusFt} ft, ${offLabel(worst.off)}), \`capped\` still passes ${pct(worstCapped)}, and it wrongly flags ${pct(worstCappedCell.onsiteWronglyFlagged)} of on-site workers where \`fair\` flags ${pct(worstFairCell.onsiteWronglyFlagged)}. The cap trades some fairness for fewer false passes; it does not remove the weakness.`);
  }

  const last = OFFSITE[OFFSITE.length - 1];
  const lastKey: MetricKey = `offsitePassed${last.key}`;
  const fairFar = maxOf(ENV_NAMES, 'fair', lastKey);
  const strictFar = maxOf(ENV_NAMES, 'strict', lastKey);
  more.push(`- **Far away is caught.** Across every environment and fence, \`fair\` passes at most ${pct(fairFar[lastKey])} of people who are ${offLabel(last)} away. \`strict\` passes up to ${(strictFar[lastKey] * 100).toFixed(2)}% (${strictFar.env}, ${strictFar.radiusFt} ft), because it trusts a fix that has no GPS lock.`);

  for (const env of weakEnvs) {
    const fMin = Math.min(...RADII_FT.map((r) => cell(env, r, 'fair').onsitePhotoAsked));
    const sMax = maxOf([env], 'strict', 'onsiteWronglyFlagged');
    more.push(`- **A weak fix becomes a photo, not a flag.** In \`${env}\`, \`fair\` asks at least ${pct(fMin)} of on-site workers for a photo and flags ${pct(maxOf([env], 'fair', 'onsiteWronglyFlagged').onsiteWronglyFlagged)}. \`strict\` wrongly flags up to ${pct(sMax.onsiteWronglyFlagged)} of them (${sMax.radiusFt} ft).`);
  }
  const photoElsewhere = maxOf(gpsEnvs, 'fair', 'onsitePhotoAsked');
  more.push(`- **Photo friction stays where it belongs.** In the other environments (${tick(gpsEnvs)}), \`fair\` asks at most ${pct(photoElsewhere.onsitePhotoAsked)} of on-site workers for a photo.`);
  p(more.join('\n'));

  // 5. Decision
  p('## Decision');
  p([
    `The shipped rule is unchanged by this eval. This report measures \`Geo.fenceStatus\` as it is; it does not change it.`,
    `Whether to change it (for example to \`capped\`) is a product decision, and it is logged in HANDOFF.md.`,
  ].join('\n'));

  return lines.join('\n').replace(/\n+$/, '') + '\n';
}

function parseArgs(argv: string[]): { check: boolean, trials: number } {
  const args = { check: false, trials: DEFAULT_TRIALS };
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === '--check') args.check = true;
    else if (argv[i] === '--trials') {
      const n = Number(argv[++i]);
      if (!Number.isInteger(n) || n <= 0) throw new Error('--trials needs a whole number above 0');
      args.trials = n;
    } else throw new Error('unknown option: ' + argv[i]);
  }
  return args;
}

function main() {
  let args: { check: boolean, trials: number };
  try {
    args = parseArgs(process.argv.slice(2));
  } catch (e) {
    console.error((e as Error).message);
    console.error('Usage: node evals/geofence/run.mts [--check] [--trials N]');
    process.exit(2);
  }
  const result = runAll({ trials: args.trials, seed: DEFAULT_SEED });
  const md = renderReport(result);
  const json = renderJson(result);
  const rel = (f: string) => path.relative(ROOT, f);
  if (args.check) {
    const stale = ([[MD_PATH, md], [JSON_PATH, json]] as const)
      .filter(([file, want]) => !fs.existsSync(file) || fs.readFileSync(file, 'utf8') !== want)
      .map(([file]) => rel(file));
    if (stale.length) {
      console.error('Out of date: ' + stale.join(', ') + '. Run `npm run eval:geofence` and commit the result.');
      process.exit(1);
    }
    console.log('Geofence eval report is current.');
    return;
  }
  fs.mkdirSync(OUT_DIR, { recursive: true });
  fs.writeFileSync(MD_PATH, md);
  fs.writeFileSync(JSON_PATH, json);
  console.log('Wrote ' + rel(MD_PATH) + ' and ' + rel(JSON_PATH) + ' (' + args.trials + ' trials per row, seed ' + DEFAULT_SEED + ').');
  if (args.trials !== DEFAULT_TRIALS) console.log('Note: the committed report uses ' + DEFAULT_TRIALS + ' trials. Re-run without --trials before committing.');
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) main();
